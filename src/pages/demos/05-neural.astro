---
import Base from '../../layouts/Base.astro';
import NodeField from '../../components/demos/neural/NodeField.astro';
import SignalLine from '../../components/demos/neural/SignalLine.astro';
import GlowOrb from '../../components/demos/neural/GlowOrb.astro';
import ConstellationMark from '../../components/demos/neural/ConstellationMark.astro';
import TimelineNode from '../../components/demos/neural/TimelineNode.astro';

/* verified facts only */
import { experience, education, work, principles, thesis, certifications, profile } from '../../data/facts.ts';

/* Persian digits */
const faNum = (n: number) => String(n).padStart(2, '0').replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]);

/* work: thesis gets its own panel */
const workItems = work.filter((w) => w.slug !== 'thesis');

/* career signal path: current roles → MSc → past roles → BA */
type Stop = { role: string; org: string; period: string; note: string; kind: 'current' | 'past' | 'edu' };
const stops: Stop[] = [
  ...experience.filter((e) => e.current).map((e) => ({
    role: e.role,
    org: e.org,
    period: e.period,
    note: e.focus,
    kind: 'current' as const,
  })),
  {
    role: education[0].degree as string,
    org: education[0].org,
    period: education[0].period,
    note: (education[0].field || education[0].note) as string,
    kind: 'edu' as const,
  },
  ...experience.filter((e) => !e.current).map((e) => ({
    role: e.role,
    org: e.org,
    period: e.period,
    note: e.focus,
    kind: 'past' as const,
  })),
  {
    role: education[1].degree as string,
    org: education[1].org,
    period: education[1].period,
    note: (education[1].field || education[1].note) as string,
    kind: 'edu' as const,
  },
];

/* signal-reading tools (subset of certifications, restyled for the act) */
const signalTools = certifications.filter((c) =>
  ['QEEG', 'نوروفیدبک', 'tDCS', 'NIBS', 'TMS', 'CANTAB'].some((k) => c.includes(k)),
);
---

<script is:inline>
  document.documentElement.classList.add('neu-js');
</script>

<Base
  title="نقشه مغز — مهدیه گنجی‌منش"
  description="مهدیه گنجی‌منش — روان‌شناسی شناختی، ارزیابی سازمانی مبتنی بر نوار مغزی، مدیریت پروژه، طراحی"
  bodyClass="neu-body"
  themeColor="#070B14"
>
  <a class="neu-skip" href="#neu-hero">پرش به محتوای اصلی</a>

  <!-- fixed night-map: generated field + orbs, no filters, no blur -->
  <div class="neu-backdrop" aria-hidden="true">
    <GlowOrb tone="blue" size="lg" style="top:-16%; inset-inline-start:-14%;" />
    <GlowOrb tone="violet" size="sm" style="top:36%; inset-inline-end:-9%;" />
    <GlowOrb tone="blue" size="lg" style="bottom:-26%; inset-inline-start:24%; opacity:.75;" />
    <NodeField />
  </div>
  <div class="neu-shade" aria-hidden="true"></div>

  <div class="neu-page">
    <header class="neu-top">
      <div class="neu-col neu-top-in">
        <a class="neu-brand" href="/demos">
          <ConstellationMark size={26} uid="brand" />
          <span class="neu-brand-text">
            <span class="neu-brand-fa">{profile.name}</span>
            <span class="neu-brand-latin">{profile.latin.toUpperCase()}</span>
          </span>
        </a>
        <nav class="neu-top-nav" aria-label="ناوبری صفحه">
          <a class="neu-top-link" href="#neu-invite">تماس</a>
          <a class="neu-top-link" href="/demos">فهرست طرح‌ها</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ═══ پرده ۰ — سیگنال ═══ -->
      <section id="neu-hero" class="neu-hero neu-col" aria-label="پرده صفر — سیگنال">
        <p class="neu-kicker neu-reveal" style="--neu-ve-delay:0ms">
          <span class="neu-kicker-act">پرده ۰ — سیگنال</span>
          <span class="neu-kicker-sep" aria-hidden="true"></span>
          <span>{profile.location}</span>
        </p>
        <h1 class="neu-name neu-reveal" style="--neu-ve-delay:70ms">{profile.name}</h1>
        <p class="neu-statement neu-reveal" style="--neu-ve-delay:140ms">
          هر آدم یک <strong class="neu-statement-em">الگو</strong>ست؛ خواندنش
          کارِ من است.
        </p>
        <p class="neu-statement-sub neu-reveal" style="--neu-ve-delay:210ms">
          من روان‌شناس شناختی‌ام؛ کارم سنجیدن است — نوار مغزی، عملکرد شناختی، و
          رفتارِ روزمره. پیش از آنکه هر چیزی را نام ببرم، الگویش را می‌خوانم؛
          بعد ترجمه‌اش می‌کنم به زبانی که تیم‌ها و سازمان‌ها بتوانند با آن تصمیم
          بگیرند.
        </p>
        <div class="neu-signal-slot neu-reveal" style="--neu-ve-delay:280ms">
          <SignalLine />
        </div>
        <a class="neu-cue neu-reveal" style="--neu-ve-delay:350ms" href="#neu-method">
          <span class="neu-cue-text">پایین‌تر</span>
          <span class="neu-cue-line" aria-hidden="true"></span>
        </a>
      </section>

      <!-- ═══ پرده ۱ — روش ═══ -->
      <section id="neu-method" class="neu-section neu-col">
        <p class="neu-tag neu-reveal">
          <span class="neu-tag-num">پرده ۰۱</span>
          <span class="neu-tag-word">روش</span>
          <span class="neu-tagline" aria-hidden="true"></span>
        </p>
        <h2 class="neu-title neu-reveal">خواندن، به‌جای حدس زدن</h2>
        <div class="neu-method neu-reveal">
          <p>
            کارشناسیِ روان‌شناسی را در دانشکده رفاه خواندم و حالا در مؤسسه علوم
            شناختی، ارشدِ علوم شناختی با گرایش روان‌شناسی شناختی ادامه می‌دهم.
            سؤالی که مسیرم را از ابتدا شکل داده ساده است: چطور می‌شود آنچه در
            سرِ آدم‌ها می‌گذرد را دقیق سنجید؟
          </p>
          <p>
            برای من سه ستون دارد: توجه، خودتنظیمی و سنجشِ شناختی. سه مفهومی که
            در آزمایشگاه اسم‌های دقیق دارند و در زندگیِ واقعی یعنی اینکه حاضرانِ
            جلسه چقدر واقعاً با فکرشان حضور دارند، چه چیزی تمرکز را می‌شکند، و
            تصمیمِ یک سازمان چقدر به حالِ ذهنیِ آدم‌هایش وابسته است.
          </p>
          <p>
            ابزارِ این خوانش را مرحله‌به‌مرحله یاد گرفته‌ام: از نقشه‌برداری مغزی
            و نوروفیدبک تا CANTAB و خانوادهٔ تحریک‌های غیرتهاجمی. و یک درس که
            از هیچ ابزاری نیامده: پشت هر خطِ موج، یک آدمِ کامل نشسته؛ نه یک
            عدد.
          </p>
        </div>
        <p class="neu-principles neu-reveal" aria-label="اصول کار">
          {principles.map((p) => <span class="neu-principle">{p}</span>)}
        </p>
        <p class="neu-pull neu-reveal">این روش باید جایی امتحان شود — جایی که آدم‌ها، پروژه‌ها و امروزها واقعی هستند.</p>
      </section>

      <!-- ═══ پرده ۲ — میدان ═══ -->
      <section id="neu-path" class="neu-section neu-col">
        <p class="neu-tag neu-reveal">
          <span class="neu-tag-num">پرده ۰۲</span>
          <span class="neu-tag-word">میدان</span>
          <span class="neu-tagline" aria-hidden="true"></span>
        </p>
        <h2 class="neu-title neu-reveal">هر نقش، یک گره</h2>
        <p class="neu-intro neu-reveal">
          روش وقتی معنا پیدا می‌کند که به میدان بیاید. مسیرم را روی خط سیگنال
          می‌بینم: گره‌های روشن همکاری‌های جاری‌اند و بقیه، عمقِ پشتِ نقشه.
        </p>
        <ol class="neu-timeline">
          {stops.map((s, i) => (
            <li
              class:list={['neu-stop', 'neu-reveal']}
              style={`--neu-ve-delay:${(i % 4) * 70}ms`}
            >
              <TimelineNode kind={s.kind} delay={(i % 4) * 70} />
              <div class="neu-stop-head">
                <h3 class="neu-stop-role">
                  {s.role}
                  {s.kind === 'current' && <span class="neu-live">گره فعال</span>}
                </h3>
                <span class="neu-period">{s.period}</span>
              </div>
              <p class="neu-stop-org">{s.org}</p>
              {s.note && <p class="neu-stop-focus">{s.note}</p>}
            </li>
          ))}
        </ol>
        <p class="neu-pull neu-reveal">تمام این گره‌ها به یک سمت اشاره می‌کنند: کاری که می‌ماند.</p>
      </section>

      <!-- ═══ پرده ۳ — اثر ═══ -->
      <section id="neu-proof" class="neu-section neu-col">
        <p class="neu-tag neu-reveal">
          <span class="neu-tag-num">پرده ۰۳</span>
          <span class="neu-tag-word">اثر</span>
          <span class="neu-tagline" aria-hidden="true"></span>
        </p>
        <h2 class="neu-title neu-reveal">گره‌های روشن</h2>
        <p class="neu-intro neu-reveal">
          چهار گره کاری که روشِ من را در عمل نشان می‌دهند — با توصیف، نه با
          عددِ گردوخامه‌ای.
        </p>
        <div class="neu-work">
          {workItems.map((w, i) => (
            <article class="neu-card neu-reveal" style={`--neu-ve-delay:${(i % 2) * 70}ms`}>
              <div class="neu-card-top">
                <span class="neu-card-n">{faNum(i + 1)}</span>
                <span class="neu-card-kind">{w.kind}</span>
              </div>
              <h3 class="neu-card-title">{w.title}</h3>
              <p class="neu-card-org">{w.org}</p>
              <p class="neu-card-body">{w.summary}</p>
              <p class="neu-card-role">{w.role}</p>
            </article>
          ))}
        </div>
        <p class="neu-thesis-cap neu-reveal">و اینجا محلِ تماسِ روش با پژوهش:</p>
        <div class="neu-thesis neu-reveal">
          <p class="neu-thesis-status">{thesis.status} — {thesis.field}</p>
          <p class="neu-thesis-title">{thesis.title}</p>
          <div class="neu-vars">
            <p class="neu-vars-label">متغیرها</p>
            <ul class="neu-chips">
              <li class="neu-chip">جهت‌گیری عملکردی / تسلطی</li>
              <li class="neu-chip">تفکر واگرا</li>
              <li class="neu-chip">تفکر همگرا</li>
              <li class="neu-chip neu-chip-mod">گشودگی به تجربه — تعدیل‌گر</li>
            </ul>
          </div>
        </div>
        <div class="neu-tools neu-reveal">
          <p class="neu-vars-label">ابزارهای خوانش سیگنال</p>
          <ul class="neu-chips">
            {signalTools.map((t) => <li class="neu-chip">{t}</li>)}
          </ul>
        </div>
        <p class="neu-pull neu-reveal">اگر بیتی از این زبان با شما آشنا بود، دعوتِ من هم کوتاه است — مثل یک خط سیگنال.</p>
      </section>

      <!-- ═══ پرده ۴ — دعوت ═══ -->
      <section id="neu-invite" class="neu-section neu-col">
        <p class="neu-tag neu-reveal">
          <span class="neu-tag-num">پرده ۰۴</span>
          <span class="neu-tag-word">دعوت</span>
          <span class="neu-tagline" aria-hidden="true"></span>
        </p>
        <h2 class="neu-title neu-reveal">همهٔ سیگنال‌ها به یک خط می‌رسند</h2>
        <p class="neu-intro neu-reveal">
          برای همکاری پژوهشی، ارزیابی سازمانی یا پروژه‌های وب و طراحی، ایمیل
          سریع‌ترین راه است. به پیام‌ها دقیق جواب می‌دهم؛ دقت را فقط در
          نمودارها نمی‌خواهم.
        </p>
        <p class="neu-mail neu-reveal">
          <a href={`mailto:${profile.email}`} dir="ltr">{profile.email}</a>
        </p>
        <p class="neu-meta neu-reveal">
          <span>{profile.location}</span>
          <span class="neu-meta-sep" aria-hidden="true"></span>
          <span dir="ltr">{profile.domain}</span>
        </p>
      </section>
    </main>

    <footer class="neu-foot neu-col">
      <div class="neu-foot-brand">
        <ConstellationMark size={22} uid="foot" />
        <span class="neu-foot-name">{profile.name}</span>
      </div>
      <p class="neu-foot-row">
        <a class="neu-foot-link" href="/demos">بازگشت به فهرست طرح‌ها<span aria-hidden="true"> ←</span></a>
      </p>
      <p class="neu-foot-meta">
        <span dir="ltr">{profile.domain}</span>
        <span dir="ltr">{profile.email}</span>
      </p>
    </footer>
  </div>
</Base>

<script>
  /* night-map: depth gain + 2-layer parallax (far ↑ 8px / near ↓ 24px, max)
     + reveal-on-scroll — rAF, transform/opacity only, frozen if reduced. */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  if (!reduced) {
    const layers = Array.from(document.querySelectorAll('.neu-nf-layer[data-shift]'));
    let raf = 0;
    const apply = () => {
      raf = 0;
      const doc = document.documentElement;
      const range = Math.max(doc.scrollHeight - innerHeight, 1);
      const p = Math.min(Math.max(scrollY / range, 0), 1);
      root.style.setProperty('--neu-deep', p.toFixed(3));
      for (const layer of layers) {
        const max = parseFloat(layer.dataset.shift || '0');
        layer.style.transform = `translate3d(0,${(p * max).toFixed(1)}px,0)`;
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (!raf) raf = requestAnimationFrame(apply);
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      if (!raf) raf = requestAnimationFrame(apply);
    });
    apply();
  }

  const revealables = document.querySelectorAll('.neu-reveal');
  if (reduced) {
    revealables.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    revealables.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  /* ================================================================
     ۰۵-neural — «نقشه مغز / Night Map»
     depth, signal, quiet · tokens exact, glows low-opacity, never
     over body text · motion grammar per DESIGN-LANGUAGE shared system
     ================================================================ */

  .neu-body {
    /* palette */
    --neu-bg: #070b14;
    --neu-surface: #0f1728;
    --neu-text: #e8eef7;
    --neu-text-soft: rgba(232, 238, 247, 0.82);
    --neu-muted: #93a0b8;
    --neu-blue: #6ea8ff;
    --neu-violet: #9b7bff;
    --neu-border: rgba(232, 238, 247, 0.12);
    /* type */
    --neu-display: var(--font-display);
    --neu-body-font: var(--font-body);
    --neu-mono: var(--font-mono);
    /* scale: display / h2 / body / small / mono-tag */
    --neu-scale-display: clamp(2.75rem, 7vw, 6.5rem);
    --neu-scale-h2: clamp(1.75rem, 4vw, 3rem);
    --neu-scale-body: 1.0625rem;
    --neu-scale-small: 0.875rem;
    --neu-scale-tag: 0.7375rem;
    /* motion grammar */
    --neu-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --neu-ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --neu-ease-linear: linear;
    --neu-dur-ui: 180ms;
    --neu-dur-enter: 420ms;
    --neu-dur-scene: 720ms;
    --neu-stagger: 70ms;
    --neu-pulse: 4s;

    background: var(--neu-bg);
    color: var(--neu-text);
    font-family: var(--neu-body-font);
    overflow-x: clip;
  }
  .neu-body ::selection {
    background: rgba(110, 168, 255, 0.32);
    color: var(--neu-text);
  }

  /* skip link */
  .neu-skip {
    position: fixed;
    top: 0;
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    z-index: 40;
    padding: 0.65rem 1.2rem;
    background: var(--neu-surface);
    color: var(--neu-text);
    border: 1px solid var(--neu-blue);
    border-radius: 0.5rem;
    font-size: var(--neu-scale-small);
    text-decoration: none;
    transform: translateY(-140%);
    transition: transform 0.22s var(--neu-ease-out);
  }
  .neu-skip:focus-visible {
    transform: translateY(0.75rem);
    outline: 2px solid var(--neu-blue);
    outline-offset: 2px;
  }

  /* ---------- fixed backdrop ---------- */
  .neu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .neu-shade {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(7, 11, 20, 0.55), transparent 18%),
      linear-gradient(to top, rgba(7, 11, 20, 0.78), transparent 28%),
      linear-gradient(
        to left,
        rgba(7, 11, 20, 0.4),
        transparent 22%,
        rgba(7, 11, 20, 0.4) 97%
      );
  }

  /* ---------- column ---------- */
  .neu-page {
    position: relative;
    z-index: 2;
  }
  .neu-col {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  /* ---------- top bar ---------- */
  .neu-top {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 20;
  }
  .neu-top::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(7, 11, 20, 0.88),
      rgba(7, 11, 20, 0)
    );
    pointer-events: none;
  }
  .neu-top-in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .neu-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--neu-text);
    border: 1px solid transparent;
    border-radius: 0.6rem;
    padding: 0.3rem 0.55rem;
    transition: border-color var(--neu-dur-ui) var(--neu-ease-out);
  }
  .neu-brand:hover,
  .neu-brand:focus-visible {
    border-color: var(--neu-border);
  }
  .neu-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .neu-brand-fa {
    font-family: var(--neu-display);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .neu-brand-latin {
    font-family: var(--neu-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--neu-muted);
  }
  .neu-top-nav {
    display: flex;
    gap: 0.35rem;
  }
  .neu-top-link,
  .neu-foot-link {
    font-size: 0.8125rem;
    color: var(--neu-muted);
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--neu-border);
    border-radius: 999px;
    background: rgba(15, 23, 40, 0.55);
    transition:
      color var(--neu-dur-ui) var(--neu-ease-out),
      border-color var(--neu-dur-ui) var(--neu-ease-out);
  }
  .neu-top-link:hover,
  .neu-top-link:focus-visible,
  .neu-foot-link:hover,
  .neu-foot-link:focus-visible {
    color: var(--neu-text);
    border-color: rgba(110, 168, 255, 0.45);
  }
  .neu-page a:focus-visible {
    outline: 2px solid var(--neu-blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ---------- hero — پرده ۰ ---------- */
  .neu-hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 7rem 4.5rem;
    scroll-margin-top: 5.5rem;
  }
  .neu-kicker {
    margin: 0 0 1.4rem;

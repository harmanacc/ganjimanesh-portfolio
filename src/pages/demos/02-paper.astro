  <script>
    // گشایشِ مرکب: ۷۲۰ms، بین‌هم‌خاندانیِ ۷۰ms، بدون شیرینِ بانس.
    // در حالتِ کاهش‌حرکت: فقط فندِ ۲۰۰ms.
    const paperItems = Array.from(document.querySelectorAll('.paper-reveal'));
    const paperReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (paperReduced) {
      paperItems.forEach((el) => el.classList.add('paper-in'));
    } else {
      // clip-path hides the element from IntersectionObserver too, so reveal
      // is driven by geometry instead of IO.
      const paperReveal = () => {
        const line = window.innerHeight * 0.92;
        for (const el of paperItems) {
          if (!el.classList.contains('paper-in') && el.getBoundingClientRect().top < line) {
            el.classList.add('paper-in');
          }
        }
      };
      paperReveal();
      window.addEventListener('scroll', paperReveal, { passive: true });
      window.addEventListener('resize', paperReveal);
      window.addEventListener('load', paperReveal);
    }
  </script>

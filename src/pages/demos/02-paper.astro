---
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/demos/paper/Monogram.astro';
import RuleOrnament from '../../components/demos/paper/RuleOrnament.astro';
import PaperGrain from '../../components/demos/paper/PaperGrain.astro';
import DropCap from '../../components/demos/paper/DropCap.astro';
import FootnoteMark from '../../components/demos/paper/FootnoteMark.astro';
---

<Base
  title="کاغذ و مرکب — مهدیه گنجی‌منش"
  themeColor="#F3EDE2"
  description="کاغذ و مرکب — برگ ۰۲ مهدیه گنجی‌منش؛ روان‌شناسی شناختی، مدیریت پروژه، طراحی."
>
  <script is:inline>document.documentElement.classList.add('paper-js');</script>

  <div class="paper-page">
    <PaperGrain />

    <!-- ═══ سرنسخه ═══ -->
    <header class="paper-masthead">
      <div class="paper-mast-top">
        <a class="paper-back paper-press" href="/demos/">فهرست طرح‌ها ←</a>
        <span class="paper-mast-chip">برگ ۰۲ / کاغذ و مرکب</span>
      </div>
      <div class="paper-mast-row">
        <Monogram class="paper-mast-mark" size={46} />
        <div class="paper-mast-names">
          <p class="paper-mast-name">مهدیه گنجی‌منش</p>
          <p class="paper-mast-latin">Mahdieh Ganjimanesh</p>
        </div>
        <span class="paper-mast-loc">تهران — ۱۴۰۵</span>
      </div>
      <RuleOrnament class="paper-mast-orn" />
      <div class="paper-mast-meta">
        <span>نشر شخصی</span>
        <span>دفتر ۰۲ از ۰۶</span>
        <span>رشته‌ها: روان‌شناسی شناختی، مدیریت پروژه، طراحی</span>
      </div>
    </header>

    <div class="paper-shell">
      <aside class="paper-rail" aria-label="پهلو نسخه و فهرست بخش‌ها">
        <div class="paper-rail-sticky">
          <p class="paper-rail-name">مهدیه گنجی‌منش</p>
          <p class="paper-rail-sub">تهران — ۱۴۰۵</p>
          <nav class="paper-rail-nav" aria-label="فهرست بخش‌ها">
            <a class="paper-press" href="#paper-signal"><span>۰۱</span> سیگنال</a>
            <a class="paper-press" href="#paper-ravesh"><span>۰۲</span> روش</a>
            <a class="paper-press" href="#paper-meydan"><span>۰۳</span> میدان</a>
            <a class="paper-press" href="#paper-asar"><span>۰۴</span> اثر</a>
            <a class="paper-press" href="#paper-daavat"><span>۰۵</span> دعوت</a>
          </nav>
          <RuleOrnament class="paper-rail-orn" />
        </div>
      </aside>

      <main class="paper-main">

        <!-- ═══ پرده ۰ — سیگنال ═══ -->
        <section id="paper-signal" class="paper-hero paper-grid" aria-label="اعلان">
          <h1 class="paper-hero-h">
            <span class="paper-reveal paper-line" style="--paper-i:0">آدم‌ها را باید خواند،</span>
            <span class="paper-reveal paper-line" style="--paper-i:1">نه دسته‌بندی کرد.</span>
          </h1>
          <div class="paper-hero-lead-col paper-reveal" style="--paper-i:2">
            <p class="paper-hero-lead">
              این جمله از جلسه‌های ارزیابی با من آمد؛ روی صفحه‌نمایشِ QEEG تکرار شد و
              امروز، شرحِ کارِ من است. روان‌شناسِ شناختی‌ام؛ خواندنِ آدم، حرفه‌ی من
              است — و دسته‌بندی، هر جا ابزار شود، حکم را می‌دزدد.
            </p>
            <p class="paper-aph">
              سنجش، پیش از حدس؛<br />انسان، پیش از عدد.
            </p>
          </div>
          <aside class="paper-hero-note">
            <p class="paper-note">
              <span class="paper-note-mark" aria-hidden="true">⁂</span>
              یادداشت ۰ — نقش‌های در جریان: کلینیک ایماژ، انستیتو مغز ایماژ، رومینر
              و مؤسسهٔ تیبو. ماجرا از پردهٔ بعد ادامه دارد.
            </p>
          </aside>
        </section>

        <!-- ═══ پرده ۱ — روش ═══ -->
        <section id="paper-ravesh" class="paper-sec">
          <div class="paper-grid">
            <div class="paper-sec-head">
              <p class="paper-kicker">پرده ۰۱ — روش</p>
              <h2 class="paper-h2 paper-reveal" style="--paper-i:0"><span>خواندن، سپس حکم</span></h2>
            </div>
            <div></div>

            <div class="paper-body paper-reveal" style="--paper-i:1">
              <DropCap>
                کوتاه بگویم: پیش از هر حکم، یک سنجش. کارشناسیِ روان‌شناسی را در
                دانشکدهٔ رفاه خواندم (۱۳۹۶ تا ۱۴۰۰) و ارشدِ علوم شناختی — گرایشِ
                روان‌شناسی شناختی — را در مؤسسهٔ علوم شناختی از ۱۴۰۲ ادامه می‌دهم.
                ذهن، پیش از رفتار، کارِ من است؛ زیرِ هر رفتار یک الگوست و زیرِ هر
                الگو، داده.
              </DropCap>
              <p class="paper-p paper-p-next">
                ابزارها روی میزِ من چیده‌اند: QEEG <FootnoteMark num="۱" href="#paper-fn-1" /> نقشهٔ
                فعالیتِ مغز را ترسیم می‌کند؛ CANTAB <FootnoteMark num="۲" href="#paper-fn-2" /> پیمانهٔ
                ریزِ شناخت است؛ tDCS و NIBS <FootnoteMark num="۳" href="#paper-fn-3" /> دستِ
                تحریکِ مغز را برایم گم‌نکردنی کرده‌اند. نوروفیدبک هم این وسط
                گره‌ای تازه باز می‌کند: از مغز، اعتماد می‌آموزم.
              </p>
            </div>
            <aside class="paper-margin">
              <p class="paper-note">
                <span class="paper-note-mark" aria-hidden="true">⁂</span>
                یادداشت ۱ — جزئیاتِ آموزش‌ها در پانوشت؛ tDCS در دانشگاه تهران،
                NIBS در مؤسسهٔ فارمد، کارآموزیِ TMS در کلینیک تیبسم (۱۴۰۲).
              </p>
            </aside>
          </div>

          <!-- سه لایه؛ لایه روان‌شناسی نخست و طولانی‌تر -->
          <article class="paper-layer" aria-labelledby="paper-layer-1">
            <header class="paper-layer-head">
              <span class="paper-layer-n">لایه ۰۱</span>
              <h3 id="paper-layer-1">روان‌شناسی شناختی</h3>
              <span class="paper-layer-caption">بخشِ اصلی متن</span>
            </header>
            <div class="paper-layer-grid">
              <div class="paper-layer-body paper-reveal" style="--paper-i:0">
                <p>
                  اول داده، سپس معنی، در آخر حکم. در ارزیابیِ شناختی، مغز با زبانِ
                  خودش — موج، پاسخ و زمانِ واکنش — حرف می‌زند؛ کارِ من ترجمه‌ی
                  این زبان برای پرسشِ درست است. هر جا که روش قدم می‌گذارد، حدس
                  کنارِ میز می‌ماند؛ دسته‌بندیِ زودهنگام هم سرِ جایش می‌نشیند.
                </p>
              </div>
              <aside class="paper-layer-note">
                <p>حاشیه — قضاوتِ بدونِ داده، شعار است.</p>
              </aside>
            </div>
          </article>

          <div class="paper-layer-duo">
            <article class="paper-layer" aria-labelledby="paper-layer-2">
              <header class="paper-layer-head">
                <span class="paper-layer-n">لایه ۰۲</span>
                <h3 id="paper-layer-2">مدیریت پروژه</h3>
              </header>
              <div class="paper-reveal" style="--paper-i:1">
                <p>
                  در کلینیک ایماژ، پروژه‌های درمانی و آموزشی از ایده تا اجرا با من راه
                  می‌افتند: برنامه، هماهنگی تیم و زمان‌بندی. کارم این است که راه تا
                  انتها باز بماند و گره‌ها وسط راه روشن شوند. پشتوانه‌اش، سال‌ها
                  اجرا و هماهنگی رویداد در کلینیک‌هاست.
                </p>
              </div>
              <aside class="paper-layer-note">
                <p>اجرا، پیش از ارائه — از دورهٔ کارگاه‌ها مانده: ۱۳۹۷ تا ۱۴۰۰.</p>
              </aside>
            </article>

            <article class="paper-layer" aria-labelledby="paper-layer-3">
              <header class="paper-layer-head">
                <span class="paper-layer-n">لایه ۰۳</span>
                <h3 id="paper-layer-3">طراحی و وب</h3>
              </header>
              <div class="paper-reveal" style="--paper-i:2">
                <p>
                  سایت‌های سازمانی را با وردپرس می‌سازم و نگه می‌دارم؛ برای مؤسسهٔ
                  تیبو مسئولِ سایت بوده‌ام و هستم — سئو، پشتیبانی فنی و محتوا، هم‌بازِ
                  همین کار است. گرافیک و محتوای شبکه‌های اجتماعی هم بیش از ده پروژهٔ
                  فریلنسر آورده‌ام. طراحی، ستاره‌ی نقشِ من نیست؛ چیدنِ نهاییِ صحنه است
                  تا یک استدلال، خواناتر بنشیند.
                </p>
              </div>
              <aside class="paper-layer-note">
                <p>ابزارها — وردپرس، سئو، فتوشاپ، تدوین ویدیو، پایتون، HTML/CSS.</p>
              </aside>
            </article>
          </div>

          <div class="paper-footnote-wrap">
            <ol class="paper-footnotes">
              <li id="paper-fn-1"><span class="paper-fn-n">۱</span> QEEG: ثبت و ترسیمِ فعالیتِ الکتریکیِ مغز.</li>
              <li id="paper-fn-2"><span class="paper-fn-n">۲</span> CANTAB: بستهٔ آزمون‌های رایانه‌ایِ سنجشِ شناختی.</li>
              <li id="paper-fn-3"><span class="paper-fn-n">۳</span> tDCS، NIBS و TMS: روش‌های تحریکِ غیرتهاجمیِ مغز.</li>
            </ol>
          </div>

          <p class="paper-pull paper-reveal" style="--paper-i:0">
            روش، روی کاغذ خشک است؛ خشکی‌اش از سخت‌گیری است. در میدان اما، وقتی به
            تیم و سازمان می‌رسد، کارِ آدمی می‌شود.
          </p>
        </section>

        <!-- ═══ پرده ۲ — میدان ═══ -->
        <section id="paper-meydan" class="paper-sec">
          <div class="paper-grid">
            <div class="paper-sec-head">
              <p class="paper-kicker">پرده ۰۲ — میدان</p>
              <h2 class="paper-h2 paper-reveal" style="--paper-i:0"><span>فهرستِ مطالب</span></h2>
              <p class="paper-p paper-p-tight paper-reveal" style="--paper-i:1">
                کارها به رسمِ فهرستِ مطالب آمده‌اند — نه به شکلِ کارت: هر سطر، یک
                عنوان، یک نهاد و یک برچسبِ موضوعی دارد.
              </p>
            </div>
            <aside class="paper-margin">
              <p class="paper-note">
                <span class="paper-note-mark" aria-hidden="true">⁂</span>
                یادداشت ۲ — اسمِ سازمان‌های ارزیابی محرمانه می‌ماند؛ این هیچ جای
                مدرک نیست، روش است.
              </p>
            </aside>
          </div>

          <ol class="paper-index">
            <li class="paper-row">
              <span class="paper-row-n">۰۱</span>
              <div class="paper-row-body">
                <h3 class="paper-row-title"><span class="paper-sweep">ارزیابی سازمانی مبتنی بر نوار مغزی</span></h3>
                <p class="paper-row-org">انستیتو مغز ایماژ — همکارِ ارزیابی</p>
                <p class="paper-row-sum">سنجشِ منابع انسانیِ سازمان‌ها با تکیه بر داده‌های عصبی‌شناختی. اسم سازمان‌ها محرمانه است.</p>
              </div>
              <span class="paper-row-kind">سنجش و تحلیل</span>
              <span class="paper-row-year">اکنون</span>
            </li>
            <li class="paper-row">
              <span class="paper-row-n">۰۲</span>
              <div class="paper-row-body">
                <h3 class="paper-row-title"><span class="paper-sweep">پروژه‌های کلینیک ایماژ</span></h3>
                <p class="paper-row-org">کلینیک ایماژ — مدیرِ پروژه</p>
                <p class="paper-row-sum">پیشبردِ پروژه‌های درمانی و آموزشی؛ هماهنگی تیم، زمان‌بندی و اجرا.</p>
              </div>
              <span class="paper-row-kind">مدیریت پروژه</span>
              <span class="paper-row-year">اکنون</span>
            </li>
            <li class="paper-row">
              <span class="paper-row-n">۰۳</span>
              <div class="paper-row-body">
                <h3 class="paper-row-title"><span class="paper-sweep">وب‌سایت‌های وردپرسی</span></h3>
                <p class="paper-row-org">کلینیک آینه و مؤسسهٔ تیبو — طراح و مسئولِ سایت</p>
                <p class="paper-row-sum">ساخت و پشتیبانی سایت‌های سازمانی؛ از محتوا و ساختار تا انتشار و نگهداری.</p>
              </div>
              <span class="paper-row-kind">طراحی و ساخت</span>
              <span class="paper-row-year">۱۴۰۱ — اکنون</span>
            </li>
            <li class="paper-row">
              <span class="paper-row-n">۰۴</span>
              <div class="paper-row-body">
                <h3 class="paper-row-title"><span class="paper-sweep">تفکر واگرا، تفکر همگرا و گشودگی به تجربه</span></h3>
                <p class="paper-row-org">پژوهشِ ارشد — پژوهشگر</p>
                <p class="paper-row-sum">بررسی رابطه‌ی جهت‌گیری عملکردی و تسلطی با تفکر واگرا و همگرا، با نقشِ تعدیل‌گرِ گشودگی به تجربه.</p>
              </div>
              <span class="paper-row-kind">پژوهش</span>
              <span class="paper-row-year">از ۱۴۰۲</span>
            </li>
            <li class="paper-row">
              <span class="paper-row-n">۰۵</span>
              <div class="paper-row-body">
                <h3 class="paper-row-title"><span class="paper-sweep">طراحی گرافیک و سوشال</span></h3>
                <p class="paper-row-org">پروژه‌های فریلنسر — طراح</p>
                <p class="paper-row-sum">بیش از ده پروژه‌ی طراحیِ گرافیک و محتوای شبکه‌های اجتماعی برای کسب‌وکارهای کوچک.</p>
              </div>
              <span class="paper-row-kind">طراحی</span>
              <span class="paper-row-year">—</span>
            </li>
          </ol>

          <p class="paper-pull paper-reveal" style="--paper-i:0">
            فهرست، نتیجه است؛ اثر زیرِ فهرست ریشه دارد — در پژوهش و در خطِ زمان.
          </p>
        </section>

        <!-- ═══ پرده ۳ — اثر ═══ -->
        <section id="paper-asar" class="paper-sec">
          <div class="paper-grid">
            <div class="paper-sec-head">
              <p class="paper-kicker">پرده ۰۳ — اثر</p>
              <h2 class="paper-h2 paper-reveal" style="--paper-i:0"><span>سؤالِ روی میز</span></h2>
            </div>
            <aside class="paper-margin">
              <p class="paper-note">
                <span class="paper-note-mark" aria-hidden="true">⁂</span>
                یادداشت ۳ — پایان‌نامه‌ی ارشد، از ۱۴۰۲ در مؤسسه‌ی علوم شناختی؛ در
                جریان است.
              </p>
            </aside>
          </div>
          <div class="paper-grid">
            <div class="paper-body paper-reveal" style="--paper-i:0">
              <p class="paper-p paper-p-tight">
                سجلِ من با فهرست تمام نمی‌شود؛ ریشه‌اش پژوهش است. پایان‌نامه‌ی ارشد،
                سؤالِ وسطِ میز است:
              </p>
              <blockquote class="paper-quote paper-reveal" style="--paper-i:1">
                <p class="paper-quote-text">رابطه‌ی جهت‌گیری عملکردی و تسلطی با تفکر واگرا و همگرا، با نقشِ تعدیل‌گرِ گشودگی به تجربه</p>
                <footer class="paper-quote-cite">پایان‌نامه‌ی کارشناسی ارشد — مؤسسه‌ی علوم شناختی، از ۱۴۰۲</footer>
              </blockquote>
              <p class="paper-p">
                پایان‌نامه در جریان است؛ فعلاً این را می‌شود گفت: پرسش را دقیق
                چیده‌ام و برای پاسخش، داده می‌خواهم. چیزی که داده نشده، ادعا
                نمی‌شود.
              </p>
            </div>
          </div>

          <!-- خطِ زمانِ فشرده‌ی مسیر -->
          <ol class="paper-path" aria-label="خط زمانی مسیر">
            <li class="paper-path-row">
              <span class="paper-path-year">۱۳۹۷ — ۱۳۹۹</span>
              <p class="paper-path-role">محتوا و اجرای کارگاه‌ها — کلینیک خانواده‌ی پویا، سپس کلینیک خانه‌ی آینه</p>
            </li>
            <li class="paper-path-row">
              <span class="paper-path-year">۱۳۹۹ — ۱۴۰۱</span>
              <p class="paper-path-role">پشتیبانی فنیِ کلاس‌های مجازی — کانون زبان ایران</p>
            </li>
            <li class="paper-path-row">
              <span class="paper-path-year">۱۴۰۰ — ۱۴۰۱</span>
              <p class="paper-path-role">کارشناس پژوهش — دانشکدهٔ رفاه؛ ارزیابِ شناختی CANTAB — مرکز مشاوره و روان‌شناسی شایسته‌پرور</p>
            </li>
            <li class="paper-path-row is-now">
              <span class="paper-path-year">۱۴۰۲ — اکنون</span>
              <p class="paper-path-role">ارشد علوم شناختی — مؤسسهٔ علوم شناختی؛ ارزیابِ روان‌شناختی و تولیدِ محتوا — رومینر؛ مسئولِ سایت — مؤسسهٔ تیبو؛ کارآموزِ TMS — تیبسم</p>
            </li>
            <li class="paper-path-row is-now">
              <span class="paper-path-year">اکنون</span>
              <p class="paper-path-role">مدیرِ پروژه — کلینیک ایماژ؛ همکارِ ارزیابیِ سازمانیِ مبتنی بر نوار مغزی — انستیتو مغز ایماژ</p>
            </li>
          </ol>

          <p class="paper-pull paper-reveal" style="--paper-i:0">
            آنچه نوشتم، سجل است؛ کوتاه اما حاکم. اگر دنبال هم‌فکری هستید، من زیرِ
            همینِ برگم.
          </p>
        </section>

        <!-- ═══ پرده ۴ — دعوت ═══ -->
        <section id="paper-daavat" class="paper-sec paper-sec-last">
          <div class="paper-grid">
            <div class="paper-sec-head">
              <p class="paper-kicker">پرده ۰۴ — دعوت</p>
              <h2 class="paper-h2 paper-reveal" style="--paper-i:0"><span>یک نامه‌ی کوتاه</span></h2>
            </div>
            <aside class="paper-margin">
              <p class="paper-note">
                <span class="paper-note-mark" aria-hidden="true">⁂</span>
                یادداشت ۴ — ناشر، نویسنده و امضای نهایی؛ یکی است.
              </p>
            </aside>
          </div>

          <div class="paper-grid">
            <div class="paper-body paper-reveal" style="--paper-i:0">
              <div class="paper-letter">
                <p class="paper-p">

---
import Base from '../layouts/Base.astro';
import BrainAtlas from '../components/atlas/BrainAtlas.astro';
import { profile } from '../data/facts';
---

<Base
  title="مغز، از نزدیک — مهدیه گنجی‌منش"
  description="اطلس تعاملی مغز؛ روان‌شناسی شناختی و ارزیابی سازمانی بر پایه‌ی داده‌ی مغزی. مهدیه گنجی‌منش."
  themeColor="#efe6d2"
  bodyClass="atlas-body"
>
  <BrainAtlas
    name={profile.name}
    email={profile.email}
    lead={profile.lead}
    location={profile.location}
  />
</Base>

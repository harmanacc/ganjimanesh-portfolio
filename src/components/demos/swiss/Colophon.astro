---
/**
 * Colophon — the closing block of the ۰۶ «سوئیسی» record.
 * Identity, one meta line (domain · city · year · back to the index),
 * then the email: the last typographic event on the page.
 */
import StampMark from './StampMark.astro';

interface Props {
  email: string;
  domain: string;
  city?: string;
  year?: string;
  demosHref?: string;
}
const {
  email,
  domain,
  city = 'تهران',
  year = '۱۴۰۵',
  demosHref = '/demos',
} = Astro.props;
---

<footer class="sw-colo">
  <div class="sw-colo-in">
    <div class="sw-colo-row">
      <div class="sw-colo-id">
        <StampMark />
        <span class="sw-colo-name">مهدیه گنجی‌منش</span>
        <span class="sw-colo-role">روان‌شناس شناختی</span>
      </div>
      <div class="sw-colo-meta">
        <span class="sw-colo-mono" dir="ltr" lang="en">{domain}</span>
        <span class="sw-colo-place">{city}، {year}</span>
        <a class="sw-link sw-colo-back" href={demosHref}>فهرست طرح‌ها</a>
      </div>
    </div>

    <div class="sw-colo-rule" aria-hidden="true"></div>

    <p class="sw-colo-mailrow">
      <a class="sw-link sw-colo-mail" href={`mailto:${email}`} dir="ltr" lang="en">
        {email}
      </a>
    </p>
  </div>
</footer>

<style is:global>
  .sw-colo {
    border-top: 1px solid var(--sw-rule, rgba(17, 17, 17, 0.16));
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2.75rem, 7vw, 4.5rem);
    /* the page interruption ends here; the mail line closes the record */
  }
  .sw-colo-in {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }

  .sw-colo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem 2.5rem;
  }

  .sw-colo-id {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .sw-colo-name {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--sw-ink, #111111);
  }
  .sw-colo-role {
    font-size: 0.875rem;
    color: var(--sw-label, #6b6b64);
  }

  .sw-colo-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-size: 0.75rem;
    color: var(--sw-label, #6b6b64);
  }
  .sw-colo-mono {
    font-family: var(--font-mono), var(--font-body);
    letter-spacing: 0.08em;
  }
  .sw-colo-place {
    font-weight: 500;
  }

  .sw-colo-rule {
    height: 1px;
    background: var(--sw-rule, rgba(17, 17, 17, 0.16));
    margin-block: clamp(1.75rem, 4vw, 2.75rem);
  }

  .sw-colo-mailrow {
    margin: 0;
    line-height: 1.4;
  }
  .sw-colo-mail {
    display: inline-block;
    font-family: var(--font-mono), var(--font-body);
    font-size: clamp(1.25rem, 4vw, 2.25rem);
    font-weight: 500;
    color: var(--sw-ink, #111111);
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .sw-colo-id {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>

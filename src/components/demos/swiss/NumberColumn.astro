---
/**
 * NumberColumn — mono act numerals ۰۱–۰۶ seated exactly on the left/right
 * margin of the 12-column grid, followed by a hairline tick and the act
 * word. The numeral is decorative; the act word carries meaning.
 */
interface Props {
  n: string; /* ۰۱ … ۰۶ */
  label?: string;
  class?: string;
}
const { n, label, class: className = '' } = Astro.props;
---

<span class:list={['sw-numcol', className]}>
  <span class="sw-numcol-n" aria-hidden="true">{n}</span>
  <span class="sw-numcol-tick" aria-hidden="true"></span>
  {label && <span class="sw-numcol-act">{label}</span>}
</span>

<style is:global>
  .sw-numcol {
    display: inline-flex;
    align-items: baseline;
    gap: 0.85rem;
    flex: none;
    /* optical nudge so the numeral sits square on the margin hairline */
    transform: translateY(-0.1em);
  }
  .sw-numcol-n {
    font-family: var(--font-mono), var(--font-body);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--sw-label, #6b6b64);
    font-variant-numeric: tabular-nums;
  }
  .sw-numcol-tick {
    width: 1.75rem;
    height: 1px;
    background: var(--sw-rule, rgba(17, 17, 17, 0.16));
    align-self: center;
  }
  .sw-numcol-act {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sw-ink, #111111);
  }
</style>

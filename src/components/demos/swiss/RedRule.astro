---
/**
 * RedRule — the single red accent rule of the ۰۶ «سوئیسی» record.
 * One per act, no more. The `overhang` variant pushes 12px past the
 * start margin so the rule reads like a ledger entry cut at the edge.
 * Decorative: aria-hidden.
 */
interface Props {
  overhang?: boolean;
  class?: string;
}
const { overhang = false, class: className = '' } = Astro.props;
---

<span class:list={['sw-redrule', { 'sw-redrule-overhang': overhang }, className]} aria-hidden="true"></span>

<style is:global>
  .sw-redrule {
    display: block;
    height: 2px;
    background: var(--sw-accent, #e63b2e);
  }
  .sw-redrule-overhang {
    margin-inline-start: -0.75rem; /* 12px overhang toward the margin edge */
  }
</style>

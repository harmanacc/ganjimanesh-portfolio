---
/**
 * RecordTable — semantic table shell for the ۰۶ «سوئیسی» record.
 * Real <table>, hairline rows, mono column heads, baseline rhythm.
 * Rows come through the slot; width lives on the caller's grid.
 */
interface Column {
  label: string;
  width?: string;
}
interface Props {
  caption: string;
  columns: Column[];
  class?: string;
}
const { caption, columns, class: className = '' } = Astro.props;
---

<div class:list={['sw-rt-wrap', className]}>
  <table class="sw-rt">
    <caption class="sw-rt-cap">{caption}</caption>
    <colgroup>
      {columns.map((c) => (c.width ? <col style={`width:${c.width}`} /> : <col />))}
    </colgroup>
    <thead>
      <tr>
        {columns.map((c) => <th scope="col">{c.label}</th>)}
      </tr>
    </thead>
    <slot />
  </table>
</div>

<style is:global>
  .sw-rt-wrap {
    width: 100%;
    min-width: 0;
  }

  .sw-rt {
    width: 100%;
    border-collapse: separate; /* row borders travel with the row reveal */
    border-spacing: 0;
    font-size: 1.0625rem;
  }

  .sw-rt-cap {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .sw-rt thead th {
    font-family: var(--font-mono), var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0; /* Persian column heads: no tracking */
    color: var(--sw-label, #6b6b64);
    text-align: start;
    vertical-align: bottom;
    padding: 0 0 0.75rem;
    border-bottom: 1px solid var(--sw-ink, #111111);
  }

  .sw-rt td {
    padding: 1rem clamp(1rem, 2.5vw, 2.25rem) 1rem 0;
    border-bottom: 1px solid var(--sw-rule, rgba(17, 17, 17, 0.16));
    vertical-align: baseline;
  }

  .sw-rt td:last-child {
    padding-inline-end: 0;
  }

  /* < 768px: the record folds into stacked entries, never overflows */
  @media (max-width: 900px) {
    .sw-rt thead,
    .sw-rt colgroup {
      display: none;
    }
    .sw-rt,
    .sw-rt tbody {
      display: block;
    }
    .sw-rt tr {
      display: block;
      padding: 1rem 0;
    }
    .sw-rt td {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.15rem 1.25rem;
      padding: 0;
      border-bottom: 0;
    }
    .sw-rt td + td {
      margin-top: 0.45rem;
    }
    .sw-rt td::before {
      content: attr(data-th);
      font-family: var(--font-mono), var(--font-body);
      font-size: 0.75rem;
      color: var(--sw-label, #6b6b64);
    }
    /* cells without a data-th label lead the entry as its title */
    .sw-rt td:not([data-th]) {
      display: block;
      width: 100%;
    }
  }
</style>

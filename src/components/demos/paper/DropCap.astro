---
// حرفِ آغازین — افتادِ حرفِ نخست با خطِ پایه‌ی آویخته.
// حرفِ نخستِ پاراگراف با ::first-letter انتخاب می‌شود؛ ریختِ نسخ و رنگِ زنگاری را
// همین حرف می‌گیرد و خطِ پایه‌اش روی خطِ دومِ متن می‌نشیند.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p class={`paper-cap ${className ?? ''}`}><slot /></p>

<style is:global>
  .paper-cap {
    position: relative;
    margin: 0;
    font-size: var(--paper-fs-prose, 1.0625rem);
    line-height: 2.05;
    text-wrap: pretty;
  }

  .paper-cap::first-letter {
    float: right;
    font-family: var(--font-naskh, var(--font-body, serif));
    font-weight: 700;
    font-size: 3.55em;
    /* خط پایه‌ی آویخته: فروافتادگیِ حرف تا خطِ متنِ دوم */
    line-height: 0.82;
    padding-block-start: 0.12em;
    padding-inline-start: 0;
    padding-inline-end: 0.4rem;
    color: var(--paper-rust, #B23A22);
  }

  @media (max-width: 640px) {
    .paper-cap::first-letter {
      font-size: 3em;
      padding-block-start: 0.08em;
    }
  }
</style>

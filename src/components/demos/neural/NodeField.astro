---
/**
 * «نقشه مغز» — the night-map field. Deterministic (seeded PRNG), so every
 * build renders the same constellation.
 * 3 depth layers: far 28 nodes / mid 20 / near 12 (60 total, within cap).
 * Curved quadratic edges, one <path> per layer, opacity encodes depth.
 * Far layer drifts up (max -8px), near layer drifts down (max +24px) —
 * the page script reads [data-shift] and animates via rAF, transform only.
 */
function mulberry32(seed: number): () => number {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

interface LayerDef {
  key: 'far' | 'mid' | 'near';
  count: number;
  rmin: number;
  rmax: number;
  op: number;
  color: string;
  edge: string;
  maxLink: number;
  edgeCap: number;
  shift: number;
  haloFill: string;
}

interface FieldNode {
  x: number;
  y: number;
  r: number;
  o: number;
  d: number;
  halo: number;
}

const W = 1440;
const H = 900;
const P = 160;
const rnd = mulberry32(19741107);

const defs: LayerDef[] = [
  {
    key: 'far',
    count: 28,
    rmin: 0.8,
    rmax: 1.5,
    op: 0.32,
    color: '#6EA8FF',
    edge: 'rgba(110,168,255,0.11)',
    maxLink: 195,
    edgeCap: 34,
    shift: -8,
    haloFill: '',
  },
  {
    key: 'mid',
    count: 20,
    rmin: 1.2,
    rmax: 2.2,
    op: 0.52,
    color: '#9B7BFF',
    edge: 'rgba(155,123,255,0.15)',
    maxLink: 235,
    edgeCap: 30,
    shift: 0,
    haloFill: '',
  },
  {
    key: 'near',
    count: 12,
    rmin: 2,
    rmax: 3.4,
    op: 0.85,
    color: '#6EA8FF',
    edge: 'rgba(110,168,255,0.22)',
    maxLink: 275,
    edgeCap: 16,
    shift: 24,
    haloFill: 'url(#neuHaloB)',
  },
];

interface Built extends LayerDef {
  d: string;
  nodes: FieldNode[];
}

const layers: Built[] = defs.map((def) => {
  const nodes: FieldNode[] = [];
  for (let i = 0; i < def.count; i++) {
    nodes.push({
      x: Math.round(rnd() * (W + P * 2) - P),
      y: Math.round(rnd() * (H + P * 2) - P),
      r: +(def.rmin + rnd() * (def.rmax - def.rmin)).toFixed(2),
      o: +(def.op * (0.6 + rnd() * 0.4)).toFixed(2),
      d: Math.round(rnd() * 4000),
      halo: def.key === 'near' ? (rnd() > 0.3 ? 1 : 0) : 0,
    });
  }
  let d = '';
  let edges = 0;
  for (let i = 0; i < nodes.length && edges < def.edgeCap; i++) {
    for (let j = i + 1; j < nodes.length && edges < def.edgeCap; j++) {
      const a = nodes[i]!;
      const b = nodes[j]!;
      if (Math.hypot(a.x - b.x, a.y - b.y) < def.maxLink) {
        const mx = Math.round((a.x + b.x) / 2 + (rnd() - 0.5) * 48);
        const my = Math.round((a.y + b.y) / 2 + (rnd() - 0.5) * 48);
        d += `M${a.x} ${a.y} Q${mx} ${my} ${b.x} ${b.y}`;
        edges++;
      }
    }
  }
  return { ...def, d, nodes };
});
---

<svg
  class="neu-nf-svg"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="neuHaloB" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#6EA8FF" stop-opacity="0.3"></stop>
      <stop offset="100%" stop-color="#6EA8FF" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="neuHaloV" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#9B7BFF" stop-opacity="0.26"></stop>
      <stop offset="100%" stop-color="#9B7BFF" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  {
    layers.map((layer) => (
      <g
        class:list={['neu-nf-layer', `neu-nf-${layer.key}`]}
        data-shift={layer.shift || undefined}
      >
        {layer.d && (
          <path d={layer.d} fill="none" stroke={layer.edge} stroke-width="1" />
        )}
        {layer.nodes.map((n) => (
          <>
            {n.halo === 1 && (
              <circle
                class="neu-nf-halo"
                cx={n.x}
                cy={n.y}
                r={n.r * 3.6}
                fill={n.r > 2.5 ? layer.haloFill : 'url(#neuHaloV)'}
                style={`animation-delay:${n.d}ms`}
              />
            )}
            <circle
              class="neu-nf-node"
              cx={n.x}
              cy={n.y}
              r={n.r}
              fill={layer.color}
              style={`animation-delay:${n.d}ms; --neu-o:${n.o}`}
            />
          </>
        ))}
      </g>
    ))
  }
</svg>

<style>
  .neu-nf-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .neu-nf-layer {
    will-change: transform;
  }
  .neu-nf-node {
    animation: neu-nf-pulse 4s ease-in-out infinite;
  }
  .neu-nf-far .neu-nf-node {
    animation-duration: 4.8s;
  }
  .neu-nf-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: neu-nf-halo-pulse 4s ease-in-out infinite;
  }
  /* depth gain: the near layer brightens as the page descends */
  .neu-nf-near {
    opacity: calc(0.62 + var(--neu-deep, 0) * 0.38);
  }
  @keyframes neu-nf-pulse {
    0%,
    100% {
      opacity: var(--neu-o, 0.5);
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes neu-nf-halo-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .neu-nf-node,
    .neu-nf-halo {
      animation: none;
    }
    .neu-nf-node {
      opacity: var(--neu-o, 0.5);
    }
    .neu-nf-halo {
      opacity: 0.4;
      transform: none;
    }
  }
</style>

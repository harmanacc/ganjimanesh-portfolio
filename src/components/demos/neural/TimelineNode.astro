---
/**
 * TimelineNode — one node on the career signal path.
 * `current` nodes live (box-shadow pulse, 4s); `edu` nodes are violet-rimmed;
 * `past` nodes are dim and still. Position comes from the page (.neu-stop).
 */
interface Props {
  kind?: 'current' | 'edu' | 'past';
  delay?: number;
}
const { kind = 'past', delay = 0 } = Astro.props;
---

<i
  class:list={['neu-tn', `neu-tn-${kind}`]}
  style={delay ? `animation-delay:${delay}ms` : undefined}
  aria-hidden="true"
>
</i>

<style>
  .neu-tn {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    box-sizing: border-box;
    background: var(--neu-bg, #070b14);
    border: 1.5px solid #3a4763;
  }
  .neu-tn-current {
    border-color: var(--neu-blue, #6ea8ff);
    animation: neu-tn-pulse 4s ease-in-out infinite;
  }
  .neu-tn-edu {
    border-color: var(--neu-violet, #9b7bff);
  }
  @keyframes neu-tn-pulse {
    0%,
    100% {
      box-shadow: 0 0 2px rgba(110, 168, 255, 0.2);
    }
    50% {
      box-shadow: 0 0 12px rgba(110, 168, 255, 0.7);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .neu-tn-current {
      animation: none;
      box-shadow: 0 0 6px rgba(110, 168, 255, 0.45);
    }
  }
</style>

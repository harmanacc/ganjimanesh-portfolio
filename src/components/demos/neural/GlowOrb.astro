---
/**
 * GlowOrb — a soft radial-gradient orb (blue or violet), two sizes.
 * Pure background painting; position it from the parent via inline style.
 * Never place it over body text. No filters, no blur.
 */
interface Props {
  tone?: 'blue' | 'violet';
  size?: 'lg' | 'sm';
  style?: string;
}
const { tone = 'blue', size = 'lg', style = '' } = Astro.props;
---

<div
  class:list={['neu-orb', `neu-orb-${tone}`, `neu-orb-${size}`]}
  style={style}
  aria-hidden="true"
>
</div>

<style>
  .neu-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .neu-orb-blue {
    background: radial-gradient(
      circle,
      rgba(110, 168, 255, 0.15) 0%,
      rgba(110, 168, 255, 0) 66%
    );
  }
  .neu-orb-violet {
    background: radial-gradient(
      circle,
      rgba(155, 123, 255, 0.13) 0%,
      rgba(155, 123, 255, 0) 66%
    );
  }
  .neu-orb-lg {
    width: 46rem;
    height: 46rem;
  }
  .neu-orb-sm {
    width: 22rem;
    height: 22rem;
  }
</style>

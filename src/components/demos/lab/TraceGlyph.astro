---
/**
 * TraceGlyph — small per-work glyph, 24×24, three variants:
 * «attention» (fixation target), «signal» (single trace), «grid» (assay grid).
 * One stroke weight (1.5), currentColor, decorative — page sets color.
 */
interface Props {
  variant: 'attention' | 'signal' | 'grid';
}

const { variant } = Astro.props;
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    variant === 'attention' && (
      <>
        <circle cx="12" cy="12" r="8.75" />
        <path d="M12 1.25 v3 M12 19.75 v3 M1.25 12 h3 M19.75 12 h3" />
        <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    variant === 'signal' && (
      <>
        <path d="M2.25 12 L6 12 L8 7 L11.5 17 L14 5.5 L16.5 14 L18 12 L21.75 12" />
        <circle cx="21.75" cy="12" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    variant === 'grid' && (
      <>
        <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="2" />
        <path d="M12 2.75 V21.25 M2.75 12 H21.25" />
        <circle cx="7.4" cy="7.4" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>

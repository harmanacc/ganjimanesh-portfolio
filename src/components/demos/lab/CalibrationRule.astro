---
/**
 * CalibrationRule — a rule with ruler ticks and a mono Latin label.
 * Sweeps in (scaleX) when its section is revealed — the «calibrate» move.
 * vector-effect keeps tick weight exact while the viewBox stretches.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;

const ticks = Array.from({ length: 31 }, (_, i) => i * 8);
---

<div class="lab-cal">
  <svg
    class="lab-cal-rule"
    viewBox="0 0 240 14"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <line class="lab-cal-base" x1="0" y1="13" x2="240" y2="13" vector-effect="non-scaling-stroke" />
    {
      ticks.map((x, i) => (
        <line
          class={i % 6 === 0 ? 'lab-cal-tick-m' : 'lab-cal-tick'}
          x1={x}
          y1={i % 6 === 0 ? 5 : 9}
          x2={x}
          y2="13"
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </svg>
  <span class="lab-cal-label" dir="ltr">{label}</span>
</div>

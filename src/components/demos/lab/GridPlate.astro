---
/**
 * GridPlate — 12-column hairline plate («آزمایشگاه»).
 * Absolutely positioned inside .lab-in; aligns with the page 12-col grid.
 * Pure markup; all styling lives in the page's global style block.
 */
interface Props {
  count?: number;
}

const { count = 12 } = Astro.props;
---

<div class="lab-gridplate" aria-hidden="true">
  {Array.from({ length: count }).map(() => <i />)}
</div>

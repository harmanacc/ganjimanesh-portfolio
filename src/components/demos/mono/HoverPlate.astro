---
// HoverPlate — cursor-follow preview panel. Text only, no images.
// Decorative duplicate of row data; keyboard/touch users get the inline copy.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mono-plate', className]} aria-hidden="true">
  <span class="mono-plate__idx"></span>
  <p class="mono-plate__kind"></p>
  <p class="mono-plate__title"></p>
  <p class="mono-plate__org"></p>
  <p class="mono-plate__line"></p>
</div>

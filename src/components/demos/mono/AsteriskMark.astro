---
// AsteriskMark — 8-spoke cobalt asterisk, one spoke offset outward.
// Decorative by default; drive size via CSS (it scales from the viewBox).
interface Props {
  class?: string;
}
const { class: className = 'mono-asterisk' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="#2B3BFF" stroke-width="2" stroke-linecap="round">
    <!-- 4 cardinal spokes -->
    <line x1="16" y1="3" x2="16" y2="13" />
    <line x1="16" y1="19" x2="16" y2="29" />
    <line x1="3" y1="16" x2="13" y2="16" />
    <!-- the offset spoke: pulled 2 unit outward, breaks the symmetry -->
    <line x1="21" y1="16" x2="31" y2="16" transform="translate(2 0)" />
    <!-- diagonals -->
    <line x1="7.5" y1="7.5" x2="12.5" y2="12.5" />
    <line x1="19.5" y1="19.5" x2="24.5" y2="24.5" />
    <line x1="24.5" y1="7.5" x2="19.5" y2="12.5" />
    <line x1="7.5" y1="24.5" x2="12.5" y2="19.5" />
  </g>
  <circle cx="16" cy="16" r="2" fill="#2B3BFF" />
</svg>

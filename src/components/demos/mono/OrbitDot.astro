---
// OrbitDot — small orbit SVG with a single cobalt dot.
// The page's only 999px-soft element; decorative.
interface Props {
  class?: string;
  label?: string;
}
const { class: className = 'mono-orbitdot', label } = Astro.props;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" {...a11y}>
  <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="1" opacity="0.35" />
  <circle cx="24" cy="24" r="13.5" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 4" opacity="0.5" />
  <!-- the single live dot -->
  <circle cx="24" cy="10.5" r="3.5" fill="#2B3BFF" />
  <circle cx="24" cy="24" r="5" fill="currentColor" />
</svg>

---
/**
 * Acid tape strip with duplicated track.
 * Single pass (22s linear, no loop) — resting state equals the first frame.
 */
interface Props {
  items?: string[];
}
const { items = ['روان‌شناسی شناختی', 'سنجش', 'اجرا'] } = Astro.props;
const row = items.map((t) => t).join(' · ');
---

<div class="arch-tape" aria-hidden="true">
  <div class="arch-tape-track">
    <span class="arch-tape-row">{row} · </span><span class="arch-tape-row">{row} · </span>
  </div>
</div>

<style>
  .arch-tape {
    overflow: hidden;
    background: var(--arch-acid, #C6FF3D);
    color: #0B0D0F;
  }
  .arch-tape-track {
    display: inline-block;
    white-space: nowrap;
    padding: 0.5rem 0;
    direction: ltr;
    animation: arch-tape-run 22s linear;
    animation-fill-mode: forwards;
  }
  .arch-tape-row {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  @keyframes arch-tape-run {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>
